{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StateMachineModel",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "initial": { "type": "string" },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["atomic", "compound", "final"] },
          "initial": { "type": "string" },
          "states": { "type": "object", "additionalProperties": { "$ref": "#/properties/states/additionalProperties" } },
          "onEnter": { "type": "array", "items": { "type": "string" } },
          "onExit": { "type": "array", "items": { "type": "string" } },
          "on": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "target": { "type": "string" },
                "guards": { "type": "array", "items": { "type": "string" } },
                "actions": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["target"]
            }
          }
        },
        "required": ["type"]
      }
    }
  },
  "required": ["id", "initial", "states"]
}
